# Copy this file to `.env` and set only the paths used by your environment.
# Never commit the resulting `.env` file.

# Optional local RCSB mirrors
PDB_MIRROR_PATH=
CCD_MIRROR_PATH=

# Optional local MSA directories
LOCAL_MSA_DIRS=

# Optional external tools
HBPLUS_PATH=
X3DNA_PATH=
DSSP_PATH=
HHFILTER_PATH=
MMSEQS2_PATH=

# Optional ColabFold/MMseqs2 databases
COLABFOLD_LOCAL_DB_PATH_GPU=
COLABFOLD_LOCAL_DB_PATH_CPU=
COLABFOLD_NET_DB_PATH_GPU=
COLABFOLD_NET_DB_PATH_CPU=

# Colon-separated checkpoint search paths
# Example: /path/to/checkpoints:/another/checkpoint/directory
FOUNDRY_CHECKPOINT_DIRS=
